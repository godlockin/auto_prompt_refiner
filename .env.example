# Google AI Studio API Configuration
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Model Configuration
# Primary: The latest preview model for reasoning
GEMINI_MODEL_PRIMARY=gemini-3.0-pro-preview

# Fallback: Vertex AI Configuration (Optional)
# If primary fails, the system will look for a JSON key file at this path
# Ensure this file exists if you want fallback capabilities
VERTEX_CREDENTIALS_PATH=./sys_init/your-service-account-key.json
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL_FALLBACK=gemini-2.5-pro
